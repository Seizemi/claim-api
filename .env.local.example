# Copy to .env.local (git-ignored) and fill in. Read by docker compose (docker-compose.override.yml).
# Same dev tenant values as the user-secrets used by dotnet run, with "__" instead of ":".
AzureAd__Authority=https://<subdomain>.ciamlogin.com/
AzureAd__TenantId=<external-tenant-id>
AzureAd__ClientId=<web-client-id>
AzureAd__ClientSecret=<client-secret>

# User management through Microsoft Graph (phase 2, app registration partner-portal-graph).
PartnerUsers__TenantId=<external-tenant-id>
PartnerUsers__TenantDomain=<subdomain>.onmicrosoft.com
PartnerUsers__GraphClientId=<graph-client-id>
PartnerUsers__GraphClientSecret=<graph-client-secret>
PartnerUsers__AppServicePrincipalId=<web-app-service-principal-object-id>

# Password chosen when exporting the development certificate (README, "Run in Docker").
ASPNETCORE_Kestrel__Certificates__Default__Password=<dev-cert-password>
