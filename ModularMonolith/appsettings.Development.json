{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=claimapi;Username=postgres;Password=postgres"
  },
  "ReverseProxy": {
    "Routes": {
      "react-dev-server": {
        "ClusterId": "react-dev-server",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "{**catch-all}"
        }
      }
    },
    "Clusters": {
      "react-dev-server": {
        "Destinations": {
          "cra": {
            "Address": "http://localhost:3000"
          }
        }
      }
    }
  }
}
