{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AzureAd": {
    "Authority": "https://<subdomain>.ciamlogin.com/",
    "TenantId": "<external-tenant-id>",
    "ClientId": "<web-client-id>",
    "ClientSecret": "<set-in-user-secrets>",
    "CallbackPath": "/signin-oidc",
    "SignedOutCallbackPath": "/signout-callback-oidc"
  },
  "PartnerUsers": {
    "TenantId": "<external-tenant-id>",
    "TenantDomain": "<subdomain>.onmicrosoft.com",
    "GraphClientId": "<graph-client-id>",
    "AppServicePrincipalId": "<web-app-service-principal-object-id>",
    "AssignableRoles": [ "Agent" ]
  },
  "Session": {
    "LifetimeHours": 8
  },
  "App": {
    "PublicUrl": "https://localhost:7001"
  }
}
