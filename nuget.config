<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- Phase 2: unpublished versions of ClaimPartners.Users, packed from ../PartnerUsers (see README). -->
    <!-- Phase 3: replaced by GitHub Packages. -->
    <add key="local-feed" value="../local-feed" />
  </packageSources>
  <!-- Our packages only ever come from our feed, so a package with the same name on nuget.org is never restored. -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="local-feed">
      <package pattern="ClaimPartners.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
