<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- ClaimPartners.Users, published by the claim-partners-users repository (see README). -->
    <add key="github" value="https://nuget.pkg.github.com/Seizemi/index.json" />
  </packageSources>
  <!-- GitHub Packages requires a token even for public packages: a GitHub token with read:packages, read from the
       NUGET_TOKEN environment variable (a user variable on a dev machine, a build secret in Docker). The token alone
       identifies the caller; the username is required by the format but not checked. -->
  <packageSourceCredentials>
    <github>
      <add key="Username" value="Seizemi" />
      <add key="ClearTextPassword" value="%NUGET_TOKEN%" />
    </github>
  </packageSourceCredentials>
  <!-- Our packages only ever come from our feed, so a package with the same name on nuget.org is never restored. -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="github">
      <package pattern="ClaimPartners.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
